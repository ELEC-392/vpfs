# Systemd service to disable USB autosuspend for Logitech Brio cameras.
#
# Install:
#   sudo cp brio-autosuspend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now brio-autosuspend.service
#
# This fires at every boot and writes power/control=on for every Logitech
# USB device found on the bus, before any camera capture starts.

[Unit]
Description=Disable USB autosuspend for Logitech Brio cameras
After=systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c '\
  set -x; \
  \
  # Step 1 (most important): Disable runtime PM on xHCI PCI host controllers. \
  # When the PCI device sleeps it cuts ALL root hubs and cameras — complete \
  # disappearance from lsusb.  USB-layer fixes cannot reach above this level. \
  for pcidev in /sys/bus/pci/devices/*/; do \
    driver=$(readlink "$pcidev/driver" 2>/dev/null | xargs basename 2>/dev/null); \
    if [ "$driver" = "xhci_hcd" ]; then \
      echo on > "$pcidev/power/control"              2>/dev/null || true; \
      echo -1 > "$pcidev/power/autosuspend_delay_ms" 2>/dev/null || true; \
      echo "brio-autosuspend: xhci_hcd PCI $pcidev set to on"; \
    fi; \
  done; \
  \
  # Step 2: Disable autosuspend on all USB root hubs. \
  for hub in /sys/bus/usb/devices/usb*/; do \
    echo on > "$hub/power/control"              2>/dev/null || true; \
    echo -1 > "$hub/power/autosuspend_delay_ms" 2>/dev/null || true; \
    echo "brio-autosuspend: root hub $hub set to on"; \
  done; \
  \
  # Step 3: Disable autosuspend on each Logitech Brio device directly. \
  for dev in /sys/bus/usb/devices/*/; do \
    vendor=$(cat "$dev/idVendor"  2>/dev/null); \
    product=$(cat "$dev/idProduct" 2>/dev/null); \
    if [ "$vendor" = "046d" ] && [ "$product" = "085e" ]; then \
      echo on > "$dev/power/control"              2>/dev/null; \
      echo -1 > "$dev/power/autosuspend_delay_ms" 2>/dev/null; \
      echo "brio-autosuspend: Brio $dev set to on"; \
    fi; \
  done'

[Install]
WantedBy=multi-user.target
