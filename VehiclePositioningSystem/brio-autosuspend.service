# Systemd service to disable USB autosuspend for Logitech Brio cameras.
#
# Install:
#   sudo cp brio-autosuspend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now brio-autosuspend.service
#
# This fires at every boot and writes power/control=on for every Logitech
# USB device found on the bus, before any camera capture starts.

[Unit]
Description=Disable USB autosuspend for Logitech Brio cameras
After=systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c '\
  for dev in /sys/bus/usb/devices/*/; do \
    vendor=$(cat "$dev/idVendor" 2>/dev/null); \
    product=$(cat "$dev/idProduct" 2>/dev/null); \
    if [ "$vendor" = "046d" ] && [ "$product" = "085e" ]; then \
      echo on  > "$dev/power/control"             2>/dev/null; \
      echo -1  > "$dev/power/autosuspend_delay_ms" 2>/dev/null; \
      echo "brio-autosuspend: disabled autosuspend on $dev"; \
    fi; \
  done'

[Install]
WantedBy=multi-user.target
