# Udev rules for three Logitech BRIO cameras
# Install with: sudo cp 99-brio-camera.rules /etc/udev/rules.d/
# Then reload: sudo udevadm control --reload-rules && sudo udevadm trigger

# ---------------------------------------------------------------------------
# Layer 1 — PCI: Disable runtime PM on the xHCI host controller itself.
# When the xHCI PCI device sleeps it takes ALL root hubs and cameras with
# it, causing a complete disappearance from lsusb.  This must be fixed at
# the PCI layer; USB-only fixes cannot reach above the root hub.
# ---------------------------------------------------------------------------
ACTION=="add", SUBSYSTEM=="pci", DRIVER=="xhci_hcd", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="pci", DRIVER=="xhci_hcd", ATTR{power/autosuspend_delay_ms}="-1"

# ---------------------------------------------------------------------------
# Layer 2 — USB: Disable autosuspend on every USB device as it is enumerated
# (root hubs, cameras, everything).  Catches anything not covered by Layer 1.
# ---------------------------------------------------------------------------
ACTION=="add", SUBSYSTEM=="usb", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"

# Camera 1 - USB port 8-1
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="085e", KERNELS=="8-1*", ATTR{index}=="0", SYMLINK+="brio-camera1", MODE="0666", GROUP="video"

# Camera 2 - USB port 6-1
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="085e", KERNELS=="6-1*", ATTR{index}=="0", SYMLINK+="brio-camera2", MODE="0666", GROUP="video"

# Camera 3 - USB port 4-1
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="085e", KERNELS=="4-1*", ATTR{index}=="0", SYMLINK+="brio-camera3", MODE="0666", GROUP="video"